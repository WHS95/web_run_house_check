# =============================================================
# RunHouse 환경변수 예시 (실제 값은 비어둠 — 커밋되는 파일)
# =============================================================
# 사용법:
#   1) 운영 키를 받아 .env.prod 로 저장
#   2) 개발 키를 받아 .env.dev 로 저장
#   3) `npm run env:prod` 또는 `npm run env:dev` 로 .env.local 활성화
#   4) `npm run dev` 로 개발 서버 실행
#
# 자세한 가이드: docs/env-switching.md
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KAKAO_SECRET_KEY=

# --- Dev 백도어 가드 (운영 false, 개발 true) ---
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

# --- 기타 인증 ---
JWT_SECRET=

# --- Naver Map ---
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_SECRET=

# --- Firebase Admin (서버) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Firebase Client ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
